---
import { getCollection, getEntry } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import SplatField from "../components/SplatField.astro";
import WorkEntry from "../components/WorkEntry.astro";
import WritingItem from "../components/WritingItem.astro";
import AffiliationEntry from "../components/AffiliationEntry.astro";
import { siteConfig } from "../site.config";
import portrait from "../assets/portrait.jpg";

const profileEntry = await getEntry("profile", "profile");
if (!profileEntry) throw new Error("profile data missing");
const profile = profileEntry.data;

const byOrder = <T extends { data: { order: number } }>(list: T[]) =>
  list.sort((a, b) => a.data.order - b.data.order);

const education = byOrder(await getCollection("education"));
const experience = byOrder(await getCollection("experience"));
const interests = byOrder(await getCollection("interests"));

// YYYY-MM strings sort correctly as text; ties keep file order.
const news = (await getCollection("news")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);
const monthYear = (ym: string) =>
  new Date(`${ym}-01T00:00:00Z`).toLocaleString("en", {
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });

const selected = (await getCollection("works", (w) => w.data.selected)).sort(
  (a, b) => b.data.year - a.data.year || a.data.order - b.data.order,
);

const recent = siteConfig.showWriting
  ? (await getCollection("writing", (p) => !p.data.draft))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
      .slice(0, 3)
  : [];

const description = `${profile.name} — ${profile.degree}, ${profile.affiliation}. ${profile.tagline}`;
---

<Base title={profile.name} description={description}>
  <section class="hero">
    <SplatField />
    <div class="canvas-host" id="hero-canvas" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="meta affiliation">{profile.degree} · {profile.institution}</p>
      <h1>{profile.name}</h1>
      <p class="tagline">{profile.tagline}</p>
      <p class="hero-line">
        {profile.affiliation}, advised by{" "}
        <a href={profile.advisor.url}>{profile.advisor.name}</a>.
      </p>
      <ul class="meta links">
        <li><a href={`mailto:${profile.email}`}>Email</a></li>
        {
          profile.github && (
            <li>
              <a href={profile.github}>GitHub</a>
            </li>
          )
        }
        {
          profile.scholar && (
            <li>
              <a href={profile.scholar}>Scholar</a>
            </li>
          )
        }
        {
          profile.cv && (
            <li>
              <a href={profile.cv}>CV</a>
            </li>
          )
        }
      </ul>
    </div>
  </section>

  <div class="container">
    <section class="section" aria-labelledby="about-label">
      <h2 class="eyebrow" id="about-label">About</h2>
      <div class="section-body about">
        <Image
          class="portrait"
          src={portrait}
          alt={`Portrait of ${profile.name}`}
          width={132}
          densities={[1, 2]}
        />
        <div class="about-text">
          {profile.bioShort && <p set:html={profile.bioShort} />}
          <p class="more meta"><a href="/about/">More about me →</a></p>
        </div>
      </div>
      {
        (education.length > 0 || experience.length > 0) && (
          <div class="glance">
            {education.length > 0 && (
              <div>
                <h3 class="meta sub">Education</h3>
                <ul class="rows">
                  {education.map((entry) => (
                    <AffiliationEntry entry={entry} compact />
                  ))}
                </ul>
              </div>
            )}
            {experience.length > 0 && (
              <div>
                <h3 class="meta sub">Experience</h3>
                <ul class="rows">
                  {experience.map((entry) => (
                    <AffiliationEntry entry={entry} compact />
                  ))}
                </ul>
              </div>
            )}
          </div>
        )
      }
    </section>

    {
      news.length > 0 && (
        <section class="section" aria-labelledby="news-label">
          <h2 class="eyebrow" id="news-label">
            News
          </h2>
          <ul class="news section-body">
            {news.map((item) => (
              <li>
                <span class="meta date">{monthYear(item.data.date)}</span>
                <span>
                  {item.data.url ? (
                    <a href={item.data.url}>{item.data.text}</a>
                  ) : (
                    item.data.text
                  )}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="section" aria-labelledby="work-label">
      <h2 class="eyebrow" id="work-label">Selected work</h2>
      <div class="section-body entries">
        {selected.map((work) => <WorkEntry work={work} />)}
      </div>
      <p class="more meta"><a href="/research/">All publications →</a></p>
    </section>

    <section class="section" aria-labelledby="research-label">
      <h2 class="eyebrow" id="research-label">Research interests</h2>
      <div class="section-body interests">
        {
          interests.map((interest) => (
            <div class="interest">
              <h3>{interest.data.title}</h3>
              <p>{interest.data.summary}</p>
            </div>
          ))
        }
      </div>
      <p class="more meta"><a href="/research/">More on my research →</a></p>
    </section>

    {
      siteConfig.showWriting && (
        <section class="section" aria-labelledby="writing-label">
          <h2 class="eyebrow" id="writing-label">
            Writing
          </h2>
          <div class="section-body">
            {recent.length > 0 &&
              recent.map((post) => <WritingItem post={post} />)}
            {recent.length === 0 && (
              <p class="empty">
                Notes and long-form writing will appear here soon.
              </p>
            )}
            <p class="more meta">
              <a href="/writing/">All writing →</a>
            </p>
          </div>
        </section>
      )
    }
  </div>
</Base>

<script>
  // Hero gate (doc 06 §3, doc 08 §4): the three.js chunk is imported only
  // when every capability check passes; otherwise the static placeholder
  // (SplatField) simply remains. Reduced motion skips entirely (doc 05 §1).
  const host = document.getElementById("hero-canvas");

  const webgl2Available = () => {
    try {
      return Boolean(document.createElement("canvas").getContext("webgl2"));
    } catch {
      return false;
    }
  };

  const conn = (
    navigator as Navigator & { connection?: { saveData?: boolean } }
  ).connection;

  const eligible =
    host &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
    webgl2Available() &&
    conn?.saveData !== true &&
    (navigator.hardwareConcurrency ?? 8) > 2;

  if (host && eligible) {
    const load = () =>
      import("../islands/hero/main").then((m) =>
        m.mountHero(host, { reduced: window.innerWidth < 640 }),
      );
    const schedule = () => {
      if ("requestIdleCallback" in window) {
        requestIdleCallback(() => void load(), { timeout: 2000 });
      } else {
        setTimeout(() => void load(), 300);
      }
    };
    schedule();

    // Back-forward cache: the shell disposes the canvas on pagehide, so a
    // page restored via the browser's Back button shows only the placeholder.
    // Mount the scene again on restore (a fresh load runs the gate anyway).
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) schedule();
    });
  }
</script>

<style>
  .hero {
    position: relative;
    border-bottom: 1px solid var(--line);
  }

  .canvas-host {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
    /* Same fade toward the text column as the placeholder (SplatField). */
    mask-image: linear-gradient(
      100deg,
      transparent 0%,
      rgba(0, 0, 0, 0.35) 30%,
      black 62%
    );
  }

  .canvas-host.is-live {
    opacity: 1;
  }

  /* Once the canvas is live, the static placeholder yields to it. */
  .hero:has(.canvas-host.is-live) :global(.field) {
    opacity: 0;
  }

  .hero :global(.field) {
    transition: opacity 900ms var(--ease-out);
  }

  /* S1 — once-only hero text reveal (doc 05 §2). CSS only; disabled under
     reduced motion by the global override. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-inner > * {
      animation: hero-reveal 600ms var(--ease-out) both;
    }

    .hero-inner > *:nth-child(2) {
      animation-delay: 60ms;
    }

    .hero-inner > *:nth-child(3) {
      animation-delay: 120ms;
    }

    .hero-inner > *:nth-child(4) {
      animation-delay: 180ms;
    }

    .hero-inner > *:nth-child(5) {
      animation-delay: 240ms;
    }
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-inner {
    position: relative;
    padding-block: clamp(var(--space-8), 14vh, var(--space-10));
    max-width: var(--container-max);
  }

  .affiliation {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  h1 {
    font-size: var(--text-hero);
    font-weight: 600;
    margin-top: var(--space-4);
  }

  .tagline {
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--text-mut);
    margin-top: var(--space-4);
    max-width: 30ch;
    text-wrap: balance;
  }

  .hero-line {
    margin-top: var(--space-4);
    color: var(--text-mut);
    max-width: 44ch;
  }

  .links {
    display: flex;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    margin-top: var(--space-6);
  }

  .links a {
    text-decoration: none;
    color: var(--accent);
  }

  .links a:hover {
    text-decoration: underline;
  }

  .section {
    padding-top: var(--space-9);
  }

  .section-body {
    margin-top: var(--space-6);
    max-width: var(--measure-list);
  }

  /* About: portrait, then the blurb at prose measure, then the rows. */
  .about {
    display: flex;
    gap: var(--space-6);
    align-items: flex-start;
    max-width: none;
  }

  .about-text {
    flex: 1;
    max-width: var(--measure-prose);
  }

  .portrait {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .glance {
    margin-top: var(--space-7);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
    gap: var(--space-5) var(--space-8);
  }

  .sub {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--line);
  }

  .rows {
    list-style: none;
    padding: 0;
  }

  .news {
    list-style: none;
    padding: 0;
  }

  .news li {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .news a {
    color: inherit;
  }

  .news a:hover {
    color: var(--accent);
  }

  .interests {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-6) var(--space-8);
  }

  .interest h3 {
    font-size: var(--text-lg);
  }

  .interest p {
    margin-top: var(--space-3);
    color: var(--text-mut);
    max-width: 60ch;
  }

  .entries > :global(* + *) {
    margin-top: var(--space-7);
  }

  .empty {
    color: var(--text-mut);
  }

  .more {
    margin-top: var(--space-5);
  }

  .more a {
    color: inherit;
    text-decoration: none;
  }

  .more a:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .hero-inner {
      padding-block: clamp(var(--space-7), 8vh, var(--space-8));
    }

    .section {
      padding-top: var(--space-7);
    }

    .section-body {
      margin-top: var(--space-5);
    }

    /* The portrait floats beside the first lines instead of sitting alone
       on a row of its own; flow-root contains the float. */
    .about {
      display: flow-root;
    }

    .portrait {
      float: left;
      width: 5.5rem;
      height: auto;
      margin: 0.25rem var(--space-4) var(--space-2) 0;
    }

    .glance {
      margin-top: var(--space-6);
      grid-template-columns: 1fr;
    }

    .news li {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
