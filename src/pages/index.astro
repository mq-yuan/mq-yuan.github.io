---
import { getCollection, getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import SplatField from "../components/SplatField.astro";
import WorkEntry from "../components/WorkEntry.astro";
import WritingItem from "../components/WritingItem.astro";

const profileEntry = await getEntry("profile", "profile");
if (!profileEntry) throw new Error("profile data missing");
const profile = profileEntry.data;

const interests = (await getCollection("interests")).sort(
  (a, b) => a.data.order - b.data.order,
);

const selected = (await getCollection("works", (w) => w.data.selected)).sort(
  (a, b) => b.data.year - a.data.year || a.data.order - b.data.order,
);

const recent = (await getCollection("writing", (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const description = `${profile.name} — ${profile.degree}, ${profile.affiliation}. ${profile.tagline}`;
---

<Base title={profile.name} description={description}>
  <section class="hero">
    <SplatField />
    <div class="canvas-host" id="hero-canvas" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="meta affiliation">{profile.affiliation}</p>
      <h1>{profile.name}</h1>
      <p class="tagline">{profile.tagline}</p>
      <ul class="meta links">
        <li><a href={`mailto:${profile.email}`}>Email</a></li>
        {
          profile.github && (
            <li>
              <a href={profile.github}>GitHub</a>
            </li>
          )
        }
        {
          profile.scholar && (
            <li>
              <a href={profile.scholar}>Scholar</a>
            </li>
          )
        }
        {
          profile.cv && (
            <li>
              <a href={profile.cv}>CV</a>
            </li>
          )
        }
      </ul>
    </div>
  </section>

  <div class="container">
    <section class="section" aria-labelledby="research-label">
      <h2 class="eyebrow" id="research-label">Research</h2>
      <div class="section-body">
        {
          interests.map((interest) => (
            <div class="interest">
              <h3>{interest.data.title}</h3>
              <p>{interest.data.summary}</p>
            </div>
          ))
        }
        <p class="more meta"><a href="/research/">More on my research →</a></p>
      </div>
    </section>

    <section class="section" aria-labelledby="work-label">
      <h2 class="eyebrow" id="work-label">Selected work</h2>
      <div class="section-body entries">
        {selected.map((work) => <WorkEntry work={work} />)}
      </div>
    </section>

    <section class="section" aria-labelledby="writing-label">
      <h2 class="eyebrow" id="writing-label">Writing</h2>
      <div class="section-body">
        {recent.length > 0 && recent.map((post) => <WritingItem post={post} />)}
        {
          recent.length === 0 && (
            <p class="empty">
              Notes and long-form writing will appear here soon.
            </p>
          )
        }
        <p class="more meta"><a href="/writing/">All writing →</a></p>
      </div>
    </section>

    <section class="section" aria-labelledby="about-label">
      <h2 class="eyebrow" id="about-label">About</h2>
      <div class="section-body">
        <p class="about-line">
          {profile.degree} at the {profile.affiliation}, advised by{" "}
          <a href={profile.advisor.url}>{profile.advisor.name}</a>.
        </p>
        <p class="more meta"><a href="/about/">More about me →</a></p>
      </div>
    </section>
  </div>
</Base>

<script>
  // Hero gate (doc 06 §3, doc 08 §4): the three.js chunk is imported only
  // when every capability check passes; otherwise the static placeholder
  // (SplatField) simply remains. Reduced motion skips entirely (doc 05 §1).
  const host = document.getElementById("hero-canvas");

  const webgl2Available = () => {
    try {
      return Boolean(document.createElement("canvas").getContext("webgl2"));
    } catch {
      return false;
    }
  };

  const conn = (
    navigator as Navigator & { connection?: { saveData?: boolean } }
  ).connection;

  const eligible =
    host &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
    webgl2Available() &&
    conn?.saveData !== true &&
    (navigator.hardwareConcurrency ?? 8) > 2;

  if (host && eligible) {
    const reduced = window.innerWidth < 640;
    const load = () =>
      import("../islands/hero/main").then((m) =>
        m.mountHero(host, { reduced }),
      );
    if ("requestIdleCallback" in window) {
      requestIdleCallback(() => void load(), { timeout: 2000 });
    } else {
      setTimeout(() => void load(), 300);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    border-bottom: 1px solid var(--line);
  }

  .canvas-host {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
    /* Same fade toward the text column as the placeholder (SplatField). */
    mask-image: linear-gradient(
      100deg,
      transparent 0%,
      rgba(0, 0, 0, 0.35) 30%,
      black 62%
    );
  }

  .canvas-host.is-live {
    opacity: 1;
  }

  /* Once the canvas is live, the static placeholder yields to it. */
  .hero:has(.canvas-host.is-live) :global(.field) {
    opacity: 0;
  }

  .hero :global(.field) {
    transition: opacity 900ms var(--ease-out);
  }

  /* S1 — once-only hero text reveal (doc 05 §2). CSS only; disabled under
     reduced motion by the global override. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-inner > * {
      animation: hero-reveal 600ms var(--ease-out) both;
    }

    .hero-inner > *:nth-child(2) {
      animation-delay: 60ms;
    }

    .hero-inner > *:nth-child(3) {
      animation-delay: 120ms;
    }

    .hero-inner > *:nth-child(4) {
      animation-delay: 180ms;
    }
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-inner {
    position: relative;
    padding-block: clamp(var(--space-8), 14vh, var(--space-10));
    max-width: var(--container-max);
  }

  .affiliation {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  h1 {
    font-size: var(--text-hero);
    font-weight: 600;
    margin-top: var(--space-4);
  }

  .tagline {
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--text-mut);
    margin-top: var(--space-4);
    max-width: 30ch;
    text-wrap: balance;
  }

  .links {
    display: flex;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    margin-top: var(--space-6);
  }

  .links a {
    text-decoration: none;
    color: var(--accent);
  }

  .links a:hover {
    text-decoration: underline;
  }

  .section {
    padding-top: var(--space-9);
  }

  .section-body {
    margin-top: var(--space-6);
    max-width: var(--measure-list);
  }

  .interest h3 {
    font-size: var(--text-lg);
  }

  .interest p {
    margin-top: var(--space-3);
    color: var(--text-mut);
    max-width: 60ch;
  }

  .entries > :global(* + *) {
    margin-top: var(--space-7);
  }

  .empty {
    color: var(--text-mut);
  }

  .more {
    margin-top: var(--space-5);
  }

  .more a {
    text-decoration: none;
  }

  .more a:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .section {
      padding-top: var(--space-8);
    }
  }
</style>
