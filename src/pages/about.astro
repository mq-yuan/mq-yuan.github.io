---
import { getCollection, getEntry } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import AffiliationEntry from "../components/AffiliationEntry.astro";
import portrait from "../assets/portrait.jpg";

const profileEntry = await getEntry("profile", "profile");
if (!profileEntry) throw new Error("profile data missing");
const profile = profileEntry.data;

const byOrder = <T extends { data: { order: number } }>(list: T[]) =>
  list.sort((a, b) => a.data.order - b.data.order);
const education = byOrder(await getCollection("education"));
const experience = byOrder(await getCollection("experience"));

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  email: `mailto:${profile.email}`,
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: profile.institution,
  },
  ...(profile.github && { sameAs: [profile.github] }),
});
---

<Base
  title="About — Mengqi Yuan"
  description={`About ${profile.name}: ${profile.degree}, ${profile.affiliation}.`}
>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />
  <div class="container">
    <header class="page-head">
      <h1>About</h1>
    </header>

    <div class="intro">
      <div class="prose">
        <p>
          I am an {profile.degree} at the {profile.affiliation}, advised by{" "}
          <a href={profile.advisor.url}>{profile.advisor.name}</a>.
          {" " + profile.tagline}
        </p>
        {profile.bio && <p set:html={profile.bio} />}
        {
          profile.undergrad && (
            <p>
              Before Nanjing, I completed my undergraduate studies at{" "}
              {profile.undergrad.school}, where I worked with{" "}
              <a href={profile.undergrad.advisor.url}>
                {profile.undergrad.advisor.name}
              </a>
              {profile.undergrad.focus && ` on ${profile.undergrad.focus}`}.
            </p>
          )
        }
      </div>
      <Image
        class="portrait"
        src={portrait}
        alt={`Portrait of ${profile.name}`}
        width={150}
        densities={[1]}
      />
    </div>

    {
      education.length > 0 && (
        <section class="cv" aria-labelledby="education-label">
          <h2 class="eyebrow" id="education-label">
            Education
          </h2>
          <ul class="rows">
            {education.map((entry) => (
              <AffiliationEntry entry={entry} />
            ))}
          </ul>
        </section>
      )
    }

    {
      experience.length > 0 && (
        <section class="cv" aria-labelledby="experience-label">
          <h2 class="eyebrow" id="experience-label">
            Experience
          </h2>
          <ul class="rows">
            {experience.map((entry) => (
              <AffiliationEntry entry={entry} />
            ))}
          </ul>
        </section>
      )
    }

    <section class="contact" aria-labelledby="contact-label">
      <h2 class="eyebrow" id="contact-label">Contact</h2>
      <ul class="meta">
        <li>
          <span class="label">Email</span>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </li>
        {
          profile.github && (
            <li>
              <span class="label">GitHub</span>
              <a href={profile.github}>
                {profile.github.replace("https://", "")}
              </a>
            </li>
          )
        }
        {
          profile.scholar && (
            <li>
              <span class="label">Scholar</span>
              <a href={profile.scholar}>profile</a>
            </li>
          )
        }
        {
          profile.cv && (
            <li>
              <span class="label">CV</span>
              <a href={profile.cv}>PDF</a>
            </li>
          )
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .page-head {
    padding-block: var(--space-8) var(--space-7);
  }

  h1 {
    font-size: var(--text-2xl);
  }

  .intro {
    display: flex;
    gap: var(--space-7);
    align-items: flex-start;
    max-width: var(--measure-list);
  }

  .intro .prose {
    flex: 1;
  }

  .portrait {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .intro {
      flex-direction: column-reverse;
    }
  }

  .cv {
    margin-top: var(--space-9);
    max-width: var(--measure-list);
  }

  .cv + .cv {
    margin-top: var(--space-8);
  }

  .contact {
    margin-top: var(--space-8);
    max-width: var(--measure-prose);
  }

  ul {
    list-style: none;
    padding: 0;
    margin-top: var(--space-5);
  }

  li {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .label {
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    font-size: var(--text-xs);
  }

  .contact a {
    text-decoration: none;
    color: var(--text);
  }

  .contact a:hover {
    color: var(--accent);
  }
</style>
