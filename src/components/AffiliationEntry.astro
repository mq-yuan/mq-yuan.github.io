---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

// One row of the About page's Education / Experience lists (doc 07 §6).
interface Props {
  entry: CollectionEntry<"education"> | CollectionEntry<"experience">;
  /** Homepage variant: no advisor line (the hero already names the advisor). */
  compact?: boolean;
}

const { entry, compact = false } = Astro.props;
const d = entry.data;
---

<li class="row">
  <div class="logo" aria-hidden="true">
    {d.logo && <Image src={d.logo} alt="" width={96} densities={[1]} />}
  </div>
  <div class="body">
    <p class="name">{d.url ? <a href={d.url}>{d.name}</a> : d.name}</p>
    <p class="title">
      {d.title}
      {d.detail && <span class="detail"> · {d.detail}</span>}
    </p>
    {
      d.group && (
        <p class="group">
          {d.group.logo &&
            (compact && d.group.url ? (
              <a
                class:list={["group-logo", { tiled: !d.group.logoDark }]}
                href={d.group.url}
                aria-label={d.group.name}
                title={d.group.name}
              >
                <Image
                  class="on-light"
                  src={d.group.logo}
                  alt=""
                  height={56}
                  densities={[1]}
                />
                {d.group.logoDark && (
                  <Image
                    class="on-dark"
                    src={d.group.logoDark}
                    alt=""
                    height={56}
                    densities={[1]}
                  />
                )}
              </a>
            ) : (
              <span class:list={["group-logo", { tiled: !d.group.logoDark }]}>
                <Image
                  class="on-light"
                  src={d.group.logo}
                  alt=""
                  height={56}
                  densities={[1]}
                />
                {d.group.logoDark && (
                  <Image
                    class="on-dark"
                    src={d.group.logoDark}
                    alt=""
                    height={56}
                    densities={[1]}
                  />
                )}
              </span>
            ))}
          {(!compact || !d.group.logo) && (
            <span class="meta">
              {d.group.url ? (
                <a href={d.group.url}>{d.group.name}</a>
              ) : (
                d.group.name
              )}
            </span>
          )}
        </p>
      )
    }
    {
      d.advisor && !compact && (
        <p class="meta advisor">
          Advised by <a href={d.advisor.url}>{d.advisor.name}</a>
        </p>
      )
    }
  </div>
  <p class="meta period">{d.period}</p>
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: var(--space-4) var(--space-5);
    align-items: start;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  /* Flex, not grid: WebKit resolves the image's percentage height against a
     flex container's definite height, but treats it as auto inside an
     auto-sized grid row, which let portrait emblems overflow the tile. */
  .logo {
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.3rem;
    background: var(--logo-tile);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .logo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .name {
    font-weight: 600;
  }

  .name a {
    text-decoration: none;
    color: var(--text);
  }

  .name a:hover {
    color: var(--accent);
  }

  .title {
    margin-top: var(--space-1);
    color: var(--text-mut);
  }

  .group {
    margin-top: var(--space-2);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  /* A wordmark with a dark-theme variant renders bare and switches per
     theme; one without a dark variant sits in the light tile so its dark
     ink stays legible on the dark theme. */
  .group-logo {
    display: inline-flex;
    align-items: center;
    height: 1.75rem;
  }

  .group-logo.tiled {
    padding-inline: 0.3rem;
    background: var(--logo-tile);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .group-logo :global(img) {
    height: 1.25rem;
    width: auto;
  }

  .group-logo :global(.on-light) {
    display: var(--show-on-light);
  }

  .group-logo :global(.on-dark) {
    display: var(--show-on-dark);
  }

  a.group-logo {
    text-decoration: none;
  }

  a.group-logo:hover {
    opacity: 0.75;
  }

  a.group-logo.tiled:hover {
    opacity: 1;
    border-color: var(--accent);
  }

  .group a {
    color: inherit;
  }

  .advisor {
    margin-top: var(--space-2);
  }

  .advisor a {
    color: inherit;
  }

  .advisor a:hover {
    color: var(--accent);
  }

  .period {
    padding-top: var(--space-1);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 3rem 1fr;
    }

    .period {
      grid-column: 2;
      padding-top: 0;
    }
  }
</style>
